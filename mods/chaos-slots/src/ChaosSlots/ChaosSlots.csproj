<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GameDir Condition="'$(GameDir)' == ''">$(SOD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Shape of Dreams</GameDir>
    <GameManagedDir>$(GameDir)\Shape of Dreams_Data\Managed</GameManagedDir>
  </PropertyGroup>

  <Target Name="CheckGameAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Dew.Core.dll')"
           Text="Shape of Dreams assemblies were not found at '$(GameManagedDir)'. Set GameDir or SOD_GAME_DIR to the installed Steam game folder." />
  </Target>

  <ItemGroup>
    <GameAssembly Include="mscorlib;netstandard;System;System.Core;0Harmony;Dew.Core;Dew.Contents;Dew.UI;Mirror;Newtonsoft.Json;UnityEngine.CoreModule;UnityEngine.UI;UnityEngine.UIModule" />
    <Reference Include="@(GameAssembly -> '$(GameManagedDir)\%(Identity).dll')" Private="false" />
  </ItemGroup>
</Project>
