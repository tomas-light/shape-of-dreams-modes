<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">$(SOD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Shape of Dreams</GameDir>
    <GameManagedDir>$(GameDir)\Shape of Dreams_Data\Managed</GameManagedDir>
  </PropertyGroup>

  <Target Name="CheckGameAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameManagedDir)\Dew.Core.dll')"
           Text="Shape of Dreams assemblies were not found at '$(GameManagedDir)'. Set GameDir or SOD_GAME_DIR to the installed Steam game folder." />
  </Target>

  <ItemGroup>
    <Compile Include="../../src/ConstellationViewer/EquippedStars.cs" Link="EquippedStars.cs" />
    <Reference Include="Dew.Core" HintPath="$(GameManagedDir)\Dew.Core.dll" />
  </ItemGroup>
</Project>
